# Browser-facing API path. Keep requests on the frontend origin for refresh cookies.
# Required for builds. This public value is compiled into the frontend bundle.
VITE_API_URL=/api/v1

# Backend origin used by the development/preview proxy.
# In Cloudflare Pages, set this to your actual HTTPS Render origin as a runtime variable.
# Do not include /api/v1. Never put backend credentials in a VITE_ variable.
BACKEND_ORIGIN=http://localhost:8080
