model attendance_sessions {
  id                                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                            String                   @db.Uuid
  employee_id                            String                   @db.Uuid
  branch_id                              String                   @db.Uuid
  shift_assignment_id                    String?                  @db.Uuid
  work_date                              DateTime                 @db.Date
  opened_at                              DateTime                 @db.Timestamptz(3)
  closed_at                              DateTime?                @db.Timestamptz(3)
  status                                 AttendanceSessionStatus  @default(OPEN)
  minutes_worked_cached                  Int?
  shift_snapshot                         Json                     @default("{}")
  branch_snapshot                        Json                     @default("{}")
  employee_id_ref                        employees                @relation("attendance_sessions_employee_id", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  branch_id_ref                          branches                 @relation("attendance_sessions_branch_id", fields: [business_id, branch_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  shift_assignment_id_ref                shift_assignments?       @relation("attendance_sessions_shift_assignment_id", fields: [business_id, shift_assignment_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref                        businesses               @relation("attendance_sessions_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
