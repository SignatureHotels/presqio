/// Live selfie captured with a check-in/out attempt. Kept in Postgres until private object storage is set up.
model attendance_photos {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String              @db.Uuid
  attempt_id      String              @unique @db.Uuid
  employee_id     String              @db.Uuid
  content_type    String
  size_bytes      Int
  /// Only when object storage isn't configured; otherwise the image is in B2 at storage_key.
  data            Bytes?
  /// Object key in the private selfie bucket, e.g. selfies/<business>/<date>/<attempt>.jpg.
  storage_key     String?             @unique
  created_at      DateTime            @default(now()) @db.Timestamptz(3)
  attempt_id_ref  attendance_attempts @relation("attendance_photos_attempt", fields: [business_id, attempt_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  employee_id_ref employees           @relation("attendance_photos_employee", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref businesses          @relation("attendance_photos_business", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([business_id, id])
  @@index([business_id, employee_id, created_at])
}

/// A day off the employee took themselves. Kept when cancelled (cancelled_at set); at most one
/// active leave per employee per day (partial unique index leave_days_one_active_per_day).
model leave_days {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String     @db.Uuid
  employee_id     String     @db.Uuid
  leave_date      DateTime   @db.Date
  reason          String?
  created_at      DateTime   @default(now()) @db.Timestamptz(3)
  cancelled_at    DateTime?  @db.Timestamptz(3)
  employee_id_ref employees  @relation("leave_days_employee", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref businesses @relation("leave_days_business", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([business_id, id])
  @@index([business_id, leave_date])
  @@index([business_id, employee_id, leave_date])
}

/// Payslip identity and statutory details; visible to organization owners/admins only.
model employee_payroll_profiles {
  employee_id       String     @id @db.Uuid
  business_id       String     @db.Uuid
  department        String     @default("")
  date_of_birth     DateTime?  @db.Date
  pan               String     @default("")
  uan               String     @default("")
  esi               String     @default("")
  bank_name         String     @default("")
  bank_account      String     @default("")
  bank_ifsc         String     @default("")
  bank_branch       String     @default("")
  last_working_date DateTime?  @db.Date
  updated_at        DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
