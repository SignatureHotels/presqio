generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum BusinessRole {
  BUSINESS_ADMIN
  BRANCH_MANAGER
  VIEWER
}

enum OnboardingStep {
  ORGANIZATION
  BUSINESS
  BRANCH
  SHIFT
  TEAM
  COMPLETED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  SIGN_IN_LINK
}

enum SessionKind {
  ADMIN
  EMPLOYEE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  SUPERSEDED
}

enum AttendanceAction {
  CHECK_IN
  CHECK_OUT
}

enum AttemptStatus {
  INITIATED
  CAPTURING
  VERIFYING
  APPROVED
  CONSUMED
  RETRYABLE_FAILURE
  REVIEW_REQUIRED
  EXPIRED
}

enum VerificationResult {
  PASS
  RETRY
  REVIEW_REQUIRED
  FAIL
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
  CORRECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model organizations {
  id                                            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                          String
  slug                                          String                     @unique
  status                                        EntityStatus               @default(ACTIVE)
  country                                       String                     @default("IN")
  default_timezone                              String                     @default("Asia/Kolkata")
  onboarding_step                               OnboardingStep             @default(ORGANIZATION)
  onboarding_completed_at                       DateTime?                  @db.Timestamptz(3)
  created_by                                    String?                    @db.Uuid
  created_at                                    DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at                                    DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  created_by_ref                                users?                     @relation("organizations_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Restrict)
  subscription                                  subscriptions?             @relation("subscriptions_organization_id")
  invitations_organization_id_rows              invitations[]              @relation("invitations_organization_id")
  businesses_organization_id_rows               businesses[]               @relation("businesses_organization_id")
  organization_memberships_organization_id_rows organization_memberships[] @relation("organization_memberships_organization_id")
  audit_logs_organization_id_rows               audit_logs[]               @relation("audit_logs_organization_id")
}

model businesses {
  id                                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                               String                         @db.Uuid
  code                                          String                         @unique
  /// Start of this organization's employee IDs (e.g. SGH -> SGH0001). Unique platform-wide.
  employee_prefix                               String                         @unique
  slug                                          String
  name                                          String
  industry                                      String?
  country                                       String                         @default("IN")
  address                                       String?
  logo_key                                      String?
  timezone                                      String                         @default("Asia/Kolkata")
  status                                        EntityStatus                   @default(ACTIVE)
  created_at                                    DateTime                       @default(now()) @db.Timestamptz(3)
  updated_at                                    DateTime                       @default(now()) @updatedAt @db.Timestamptz(3)
  invitations_business_rows                     invitations[]                  @relation("invitations_business")
  business_membership_branches_business_id_rows business_membership_branches[] @relation("business_membership_branches_business_id")
  organization_id_ref                           organizations                  @relation("businesses_organization_id", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_memberships_business_id_rows         business_memberships[]         @relation("business_memberships_business_id")
  employees_business_id_rows                    employees[]                    @relation("employees_business_id")
  activation_tokens_business_id_rows            activation_tokens[]            @relation("activation_tokens_business_id")
  branches_business_id_rows                     branches[]                     @relation("branches_business_id")
  geofences_business_id_rows                    geofences[]                    @relation("geofences_business_id")
  employee_branch_assignments_business_id_rows  employee_branch_assignments[]  @relation("employee_branch_assignments_business_id")
  shifts_business_id_rows                       shifts[]                       @relation("shifts_business_id")
  shift_assignments_business_id_rows            shift_assignments[]            @relation("shift_assignments_business_id")
  calendars_business_id_rows                    calendars[]                    @relation("calendars_business_id")
  face_enrollments_business_id_rows             face_enrollments[]             @relation("face_enrollments_business_id")
  attendance_attempts_business_id_rows          attendance_attempts[]          @relation("attendance_attempts_business_id")
  face_checks_business_id_rows                  face_checks[]                  @relation("face_checks_business_id")
  location_checks_business_id_rows              location_checks[]              @relation("location_checks_business_id")
  attendance_sessions_business_id_rows          attendance_sessions[]          @relation("attendance_sessions_business_id")
  attendance_events_business_id_rows            attendance_events[]            @relation("attendance_events_business_id")
  attendance_corrections_business_id_rows       attendance_corrections[]       @relation("attendance_corrections_business_id")
  approvals_business_id_rows                    approvals[]                    @relation("approvals_business_id")
  attendance_adjustments_business_id_rows       attendance_adjustments[]       @relation("attendance_adjustments_business_id")
  audit_logs_business_id_rows                   audit_logs[]                   @relation("audit_logs_business_id")
  report_jobs_business_id_rows                  report_jobs[]                  @relation("report_jobs_business_id")
  privacy_notices_business_id_rows              privacy_notices[]              @relation("privacy_notices_business_id")
  privacy_acknowledgements_business_id_rows     privacy_acknowledgements[]     @relation("privacy_acknowledgements_business_id")
  retention_jobs_business_id_rows               retention_jobs[]               @relation("retention_jobs_business_id")
  notification_jobs_business_id_rows            notification_jobs[]            @relation("notification_jobs_business_id")

  attendance_photos_business_rows attendance_photos[]         @relation("attendance_photos_business")
  leave_days_business_rows        leave_days[]                @relation("leave_days_business")
  payroll_settings_row            payroll_settings?
  employee_payroll_profiles_rows  employee_payroll_profiles[]
  payroll_compensations_rows      payroll_compensations[]
  payroll_runs_rows               payroll_runs[]
  payroll_items_rows              payroll_items[]
  payroll_payments_rows           payroll_payments[]

  @@unique([organization_id, id])
  @@unique([organization_id, slug])
}

model users {
  id                                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  display_name                             String
  /// Stored lower-cased; null for employee-only (PIN) users.
  email                                    String?                    @unique
  email_verified_at                        DateTime?                  @db.Timestamptz(3)
  phone                                    String?
  status                                   EntityStatus               @default(ACTIVE)
  last_login_at                            DateTime?                  @db.Timestamptz(3)
  created_at                               DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at                               DateTime                   @default(now()) @updatedAt @db.Timestamptz(3)
  organizations_created_by_rows            organizations[]            @relation("organizations_created_by")
  invitations_invited_by_rows              invitations[]              @relation("invitations_invited_by")
  auth_tokens_user_id_rows                 auth_tokens[]              @relation("auth_tokens_user_id")
  organization_memberships_user_id_rows    organization_memberships[] @relation("organization_memberships_user_id")
  business_memberships_user_id_rows        business_memberships[]     @relation("business_memberships_user_id")
  employees_user_id_rows                   employees[]                @relation("employees_user_id")
  credentials_user_id_rows                 credentials[]              @relation("credentials_user_id")
  activation_tokens_issued_by_rows         activation_tokens[]        @relation("activation_tokens_issued_by")
  sessions_user_id_rows                    sessions[]                 @relation("sessions_user_id")
  face_enrollments_approved_by_rows        face_enrollments[]         @relation("face_enrollments_approved_by")
  attendance_corrections_requester_id_rows attendance_corrections[]   @relation("attendance_corrections_requester_id")
  attendance_corrections_reviewer_id_rows  attendance_corrections[]   @relation("attendance_corrections_reviewer_id")
  approvals_reviewer_id_rows               approvals[]                @relation("approvals_reviewer_id")
  attendance_adjustments_approved_by_rows  attendance_adjustments[]   @relation("attendance_adjustments_approved_by")
  audit_logs_actor_id_rows                 audit_logs[]               @relation("audit_logs_actor_id")
  report_jobs_requested_by_rows            report_jobs[]              @relation("report_jobs_requested_by")
  notification_jobs_user_id_rows           notification_jobs[]        @relation("notification_jobs_user_id")
}

model organization_memberships {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String           @db.Uuid
  user_id             String           @db.Uuid
  role                OrganizationRole @default(MEMBER)
  status              EntityStatus     @default(ACTIVE)
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  organization_id_ref organizations    @relation("organization_memberships_organization_id", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user_id_ref         users            @relation("organization_memberships_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organization_id, user_id])
  @@index([user_id])
}

/// Business-level access for organization MEMBERs. OWNER/ADMIN manage every business without rows here.
model business_memberships {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String                         @db.Uuid
  user_id           String                         @db.Uuid
  role              BusinessRole
  created_at        DateTime                       @default(now()) @db.Timestamptz(3)
  user_id_ref       users                          @relation("business_memberships_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref   businesses                     @relation("business_memberships_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch_scope_rows business_membership_branches[] @relation("business_membership_branches_membership")

  @@unique([business_id, user_id])
  @@unique([business_id, id])
  @@index([user_id])
}

/// Optional branch restriction for a business membership; no rows means all branches.
model business_membership_branches {
  business_id     String               @db.Uuid
  membership_id   String               @db.Uuid
  branch_id       String               @db.Uuid
  business_id_ref businesses           @relation("business_membership_branches_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership_ref  business_memberships @relation("business_membership_branches_membership", fields: [business_id, membership_id], references: [business_id, id], onDelete: Cascade, onUpdate: Restrict)
  branch_ref      branches             @relation("business_membership_branches_branch", fields: [business_id, branch_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([membership_id, branch_id])
}

model invitations {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String           @db.Uuid
  /// Stored lower-cased.
  email               String
  organization_role   OrganizationRole @default(MEMBER)
  business_id         String?          @db.Uuid
  business_role       BusinessRole?
  token_hash          String           @unique
  invited_by          String           @db.Uuid
  expires_at          DateTime         @db.Timestamptz(3)
  accepted_at         DateTime?        @db.Timestamptz(3)
  revoked_at          DateTime?        @db.Timestamptz(3)
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  organization_id_ref organizations    @relation("invitations_organization_id", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_ref        businesses?      @relation("invitations_business", fields: [organization_id, business_id], references: [organization_id, id], onDelete: Restrict, onUpdate: Restrict)
  invited_by_ref      users            @relation("invitations_invited_by", fields: [invited_by], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organization_id, email])
}

model auth_tokens {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String           @db.Uuid
  purpose     AuthTokenPurpose
  token_hash  String           @unique
  expires_at  DateTime         @db.Timestamptz(3)
  consumed_at DateTime?        @db.Timestamptz(3)
  created_at  DateTime         @default(now()) @db.Timestamptz(3)
  user_id_ref users            @relation("auth_tokens_user_id", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([user_id, purpose])
}

/// Plan catalogue (seeded). Null limits mean unlimited.
model plans {
  code                String          @id
  name                String
  max_businesses      Int?
  max_branches        Int?
  max_employees       Int?
  monthly_price_minor Int             @default(0)
  currency            String          @default("INR")
  is_public           Boolean         @default(true)
  subscriptions_rows  subscriptions[] @relation("subscriptions_plan_code")
}

model subscriptions {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String             @unique @db.Uuid
  plan_code                String
  status                   SubscriptionStatus @default(TRIALING)
  trial_ends_at            DateTime?          @db.Timestamptz(3)
  current_period_end       DateTime?          @db.Timestamptz(3)
  provider                 String?
  provider_customer_id     String?
  provider_subscription_id String?            @unique
  created_at               DateTime           @default(now()) @db.Timestamptz(3)
  updated_at               DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  organization_id_ref      organizations      @relation("subscriptions_organization_id", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan_ref                 plans              @relation("subscriptions_plan_code", fields: [plan_code], references: [code], onDelete: Restrict, onUpdate: Restrict)
}

model employees {
  id                                           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                                  String                        @db.Uuid
  user_id                                      String?                       @db.Uuid
  /// Unique across all organizations: employees sign in with just this ID.
  employee_code                                String                        @unique
  full_name                                    String
  phone                                        String?
  job_title                                    String?
  email                                        String?
  status                                       EmployeeStatus                @default(PENDING)
  joined_on                                    DateTime?                     @db.Date
  created_at                                   DateTime                      @default(now()) @db.Timestamptz(3)
  user_id_ref                                  users?                        @relation("employees_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref                              businesses                    @relation("employees_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activation_tokens_employee_id_rows           activation_tokens[]           @relation("activation_tokens_employee_id")
  employee_branch_assignments_employee_id_rows employee_branch_assignments[] @relation("employee_branch_assignments_employee_id")
  shift_assignments_employee_id_rows           shift_assignments[]           @relation("shift_assignments_employee_id")
  face_enrollments_employee_id_rows            face_enrollments[]            @relation("face_enrollments_employee_id")
  attendance_attempts_employee_id_rows         attendance_attempts[]         @relation("attendance_attempts_employee_id")
  attendance_sessions_employee_id_rows         attendance_sessions[]         @relation("attendance_sessions_employee_id")
  attendance_events_employee_id_rows           attendance_events[]           @relation("attendance_events_employee_id")
  attendance_corrections_employee_id_rows      attendance_corrections[]      @relation("attendance_corrections_employee_id")
  privacy_acknowledgements_employee_id_rows    privacy_acknowledgements[]    @relation("privacy_acknowledgements_employee_id")

  attendance_photos_rows     attendance_photos[]        @relation("attendance_photos_employee")
  leave_days_rows            leave_days[]               @relation("leave_days_employee")
  payroll_compensations_rows payroll_compensations[]
  payroll_items_rows         payroll_items[]
  payroll_profile_row        employee_payroll_profiles?

  @@unique([business_id, employee_code])
  @@unique([business_id, user_id])
  @@unique([business_id, id])
  @@index([business_id, status])
}

model credentials {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @unique @db.Uuid
  /// Admin login (argon2id). At least one of password_hash / pin_hash is set.
  password_hash   String?
  /// Employee mobile login.
  pin_hash        String?
  changed_at      DateTime  @default(now()) @db.Timestamptz(3)
  failed_attempts Int       @default(0)
  locked_until    DateTime? @db.Timestamptz(3)
  user_id_ref     users     @relation("credentials_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model activation_tokens {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String     @db.Uuid
  employee_id     String     @db.Uuid
  token_hash      String     @unique
  expires_at      DateTime   @db.Timestamptz(3)
  consumed_at     DateTime?  @db.Timestamptz(3)
  issued_by       String     @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamptz(3)
  employee_id_ref employees  @relation("activation_tokens_employee_id", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  issued_by_ref   users      @relation("activation_tokens_issued_by", fields: [issued_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref businesses @relation("activation_tokens_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([business_id, id])
}

model sessions {
  id                          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     String      @db.Uuid
  kind                        SessionKind @default(ADMIN)
  refresh_token_hash          String      @unique
  /// Previous token, still accepted for a short grace period after rotation.
  previous_refresh_token_hash String?     @unique
  rotated_at                  DateTime?   @db.Timestamptz(3)
  expires_at                  DateTime    @db.Timestamptz(3)
  revoked_at                  DateTime?   @db.Timestamptz(3)
  last_used_at                DateTime?   @db.Timestamptz(3)
  ip                          String?
  user_agent                  String?
  device_metadata             Json        @default("{}")
  created_at                  DateTime    @default(now()) @db.Timestamptz(3)
  user_id_ref                 users       @relation("sessions_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id, expires_at])
}

model branches {
  id                                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                                String                         @db.Uuid
  code                                       String
  name                                       String
  address                                    String?
  status                                     EntityStatus                   @default(ACTIVE)
  timezone                                   String                         @default("Asia/Kolkata")
  business_id_ref                            businesses                     @relation("branches_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business_membership_branches_branch_rows   business_membership_branches[] @relation("business_membership_branches_branch")
  geofences_branch_id_rows                   geofences[]                    @relation("geofences_branch_id")
  employee_branch_assignments_branch_id_rows employee_branch_assignments[]  @relation("employee_branch_assignments_branch_id")
  attendance_attempts_branch_id_rows         attendance_attempts[]          @relation("attendance_attempts_branch_id")
  attendance_sessions_branch_id_rows         attendance_sessions[]          @relation("attendance_sessions_branch_id")
  attendance_events_branch_id_rows           attendance_events[]            @relation("attendance_events_branch_id")

  @@unique([business_id, code])
  @@unique([business_id, id])
}

model geofences {
  id                               String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                      String                               @db.Uuid
  branch_id                        String                               @db.Uuid
  center                           Unsupported("geography(Point,4326)")
  radius_m                         Float                                @default(100)
  max_accuracy_m                   Float                                @default(50)
  active_from                      DateTime                             @default(now()) @db.Timestamptz(3)
  active_to                        DateTime?                            @db.Timestamptz(3)
  branch_id_ref                    branches                             @relation("geofences_branch_id", fields: [business_id, branch_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref                  businesses                           @relation("geofences_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location_checks_geofence_id_rows location_checks[]                    @relation("location_checks_geofence_id")

  @@unique([business_id, id])
}

model employee_branch_assignments {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String     @db.Uuid
  employee_id     String     @db.Uuid
  branch_id       String     @db.Uuid
  effective_from  DateTime   @default(now()) @db.Timestamptz(3)
  effective_to    DateTime?  @db.Timestamptz(3)
  employee_id_ref employees  @relation("employee_branch_assignments_employee_id", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  branch_id_ref   branches   @relation("employee_branch_assignments_branch_id", fields: [business_id, branch_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref businesses @relation("employee_branch_assignments_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([business_id, id])
  @@index([business_id, employee_id, effective_from])
}

model shifts {
  id                              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                     String              @db.Uuid
  name                            String
  starts_local                    DateTime            @db.Time(0)
  ends_local                      DateTime            @db.Time(0)
  timezone                        String              @default("Asia/Kolkata")
  grace_min                       Int                 @default(10)
  break_min                       Int                 @default(0)
  overnight                       Boolean             @default(false)
  policy_json                     Json                @default("{}")
  business_id_ref                 businesses          @relation("shifts_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shift_assignments_shift_id_rows shift_assignments[] @relation("shift_assignments_shift_id")

  @@unique([business_id, id])
}

model shift_assignments {
  id                                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                                  String                @db.Uuid
  employee_id                                  String                @db.Uuid
  shift_id                                     String                @db.Uuid
  effective_from                               DateTime              @db.Date
  effective_to                                 DateTime?             @db.Date
  weekly_pattern                               Json                  @default("[1,2,3,4,5]")
  employee_id_ref                              employees             @relation("shift_assignments_employee_id", fields: [business_id, employee_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  shift_id_ref                                 shifts                @relation("shift_assignments_shift_id", fields: [business_id, shift_id], references: [business_id, id], onDelete: Restrict, onUpdate: Restrict)
  business_id_ref                              businesses            @relation("shift_assignments_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendance_sessions_shift_assignment_id_rows attendance_sessions[] @relation("attendance_sessions_shift_assignment_id")

  @@unique([business_id, id])
  @@index([business_id, employee_id, effective_from])
}

model calendars {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String     @db.Uuid
  name            String
  calendar_date   DateTime   @db.Date
  is_working_day  Boolean    @default(false)
  policy_json     Json       @default("{}")
  business_id_ref businesses @relation("calendars_business_id", fields: [business_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([business_id, calendar_date])
  @@unique([business_id, id])
}

model face_enrollments {
  id                             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                    String           @db.Uuid
