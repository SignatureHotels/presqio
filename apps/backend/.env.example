NODE_ENV=development
PORT=8080
UI_ORIGIN=http://localhost:300
DATABASE_URL=postgresql://presqio:presqio_local@localhost:5432/presqio?schema=public&connect_timeout=3
REDIS_URL=redis://localhost:6379
AWS_REGION=ap-south-1
# Admin auth. Production requires a random secret of 32+ characters (e.g. openssl rand -base64 48).
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Public frontend URL used in emailed links (defaults to UI_ORIGIN).
APP_URL=http://localhost:300
# Outgoing email, in order of preference:
# 1. Gmail API (HTTPS, free, no domain needed, works on Render Free): set all four.
#    The client and refresh token come from a Google Cloud "Desktop app" OAuth client with the
#    gmail.send permission (the Jarvis project's scripts/gmail_token.py produces them).
# GMAIL_USER=presqio.team@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# 2. Resend HTTPS API (works on Render Free; reaches other people only from a verified domain).
# RESEND_API_KEY=re_your_key
# MAIL_FROM=Presqio <no-reply@your-verified-domain.com>
# For testing only: MAIL_FROM=Presqio <onboarding@resend.dev>
# The test sender can deliver only to the email address used for your Resend account.
# SMTP is used only when RESEND_API_KEY is unset. With neither, development logs emails.
# Gmail: smtp.gmail.com, port 587, and a Google "App password" (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients; defaults to "Presqio <SMTP_USER>".
# MAIL_FROM=Presqio <no-reply@example.com>

# Optional private S3-compatible photo storage: set all five values, or none.
# Without these, selfies are stored in Postgres.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
